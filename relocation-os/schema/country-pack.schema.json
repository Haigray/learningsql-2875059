{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://relocation-os/schema/country-pack.schema.json",
  "title": "Relocation OS Country Pack",
  "description": "One country's complete relocation decision tree. Every country pack uses this identical structure so the renderer, the app, and the buyer's mental model stay the same across products.",
  "type": "object",
  "required": [
    "meta",
    "realityCheck",
    "tree",
    "pathways",
    "modules",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "country",
        "countryCode",
        "version",
        "verifiedAsOf",
        "origin",
        "currency",
        "priceUsd",
        "edition"
      ],
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": "string"
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "verifiedAsOf": {
          "type": "string",
          "format": "date",
          "description": "Date every fact in this pack was last checked against the cited sources."
        },
        "reviewDue": {
          "type": "string",
          "format": "date",
          "description": "Date the pack must be re-verified. Drives the content-freshness workflow."
        },
        "origin": {
          "type": "string",
          "description": "Country the buyer is departing from. Exit-side admin differs per origin."
        },
        "currency": {
          "type": "string"
        },
        "fxNote": {
          "type": "string"
        },
        "priceUsd": {
          "type": "number"
        },
        "tagline": {
          "type": "string"
        },
        "edition": {
          "enum": [
            "navigator",
            "reviewed"
          ],
          "description": "'navigator' = verified against public primary and government sources by the publisher, with a self-verification procedure supplied to the buyer; no licensed professional reviewed it. 'reviewed' = a licensed practitioner in the destination country reviewed this pack. The rendered guide states which, prominently. Never claim 'reviewed' without a named reviewer and a date."
        },
        "reviewedBy": {
          "type": "string",
          "description": "Required when edition is 'reviewed'. Who reviewed it and when."
        }
      }
    },
    "realityCheck": {
      "type": "array",
      "description": "Things that do NOT exist or do not work the way buyers assume. Sold first, before any pathway, because it prevents the most expensive mistakes and establishes that the guide is not marketing.",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "reality",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string",
            "description": "The widespread belief."
          },
          "reality": {
            "type": "string",
            "description": "What is actually true."
          },
          "why": {
            "type": "string",
            "description": "Why the myth persists / who profits from it."
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tree": {
      "type": "object",
      "description": "The if/then flowchart. A directed graph of question nodes terminating in pathway or dead-end nodes.",
      "required": [
        "entry",
        "nodes"
      ],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "description": "id of the first node"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "type": {
                "enum": [
                  "question",
                  "outcome",
                  "deadend"
                ]
              },
              "question": {
                "type": "string",
                "description": "Required for type=question."
              },
              "help": {
                "type": "string",
                "description": "Plain-language explanation of what the question really means, and how people get it wrong."
              },
              "answers": {
                "type": "array",
                "description": "Required for type=question. Each answer is an if/then edge.",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "next"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "next": {
                      "type": "string",
                      "description": "id of the next node"
                    }
                  }
                }
              },
              "pathwayId": {
                "type": "string",
                "description": "Required for type=outcome. Which pathway this lands on."
              },
              "verdict": {
                "type": "string",
                "description": "Required for type=deadend. The honest 'this does not work' answer."
              },
              "alternatives": {
                "type": "array",
                "description": "For dead ends: what to actually do instead.",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "pathways": {
      "type": "array",
      "description": "Every legal route into long-term residence. One per visa/permit strategy.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "summary",
          "difficulty",
          "eligibility",
          "steps",
          "verification"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "visaCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "bestFor": {
            "type": "string"
          },
          "difficulty": {
            "enum": [
              "low",
              "moderate",
              "high",
              "very-high"
            ]
          },
          "durationGranted": {
            "type": "string"
          },
          "renewable": {
            "type": "string"
          },
          "leadsToPermanentResidence": {
            "type": "string"
          },
          "canBringFamily": {
            "type": "string"
          },
          "canWorkLocally": {
            "type": "string"
          },
          "eligibility": {
            "type": "array",
            "description": "Hard gates. If a buyer fails one, this pathway is closed to them.",
            "items": {
              "type": "object",
              "required": [
                "requirement"
              ],
              "additionalProperties": false,
              "properties": {
                "requirement": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "costs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item",
                "amount"
              ],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "timeline": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "title",
                "detail"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "who": {
                  "type": "string",
                  "description": "Who performs this step: you, your employer, your lawyer, a Vietnamese sponsor."
                },
                "where": {
                  "type": "string"
                },
                "takes": {
                  "type": "string"
                },
                "blocker": {
                  "type": "string",
                  "description": "What must be finished before this step can start."
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "url": {
                  "type": "string",
                  "description": "Official portal for this step, where one exists."
                },
                "critical": {
                  "type": "boolean",
                  "description": "True when skipping or mis-sequencing this step breaks the pathway."
                }
              }
            }
          },
          "failureModes": {
            "type": "array",
            "description": "Specific, named ways applications on this pathway get rejected.",
            "items": {
              "type": "object",
              "required": [
                "mistake",
                "consequence",
                "avoid"
              ],
              "additionalProperties": false,
              "properties": {
                "mistake": {
                  "type": "string"
                },
                "consequence": {
                  "type": "string"
                },
                "avoid": {
                  "type": "string"
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "verification": {
            "type": "array",
            "description": "How the BUYER confirms this pathway themselves, in under an hour, before spending money. This is what replaces a professional review: we do not ask to be trusted, we hand over the procedure. Every pathway must have at least one.",
            "items": {
              "type": "object",
              "required": [
                "check",
                "authority",
                "how"
              ],
              "additionalProperties": false,
              "properties": {
                "check": {
                  "type": "string",
                  "description": "The specific thing to confirm."
                },
                "authority": {
                  "type": "string",
                  "description": "The office or body that can actually answer it. Not a law firm, not a forum."
                },
                "how": {
                  "type": "string",
                  "description": "Exactly what to do: which portal, which counter, or what to ask, phrased so it can be copied verbatim."
                },
                "url": {
                  "type": "string"
                },
                "expectAnswer": {
                  "type": "string",
                  "description": "What a correct answer sounds like, so the buyer can tell whether they were fobbed off."
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "description": "Phase-ordered checklists that apply regardless of which pathway the buyer took. Identical phase spine in every country pack.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "title",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "phase": {
            "enum": [
              "decide",
              "documents",
              "exit-origin",
              "money",
              "arrival",
              "first-90-days",
              "ongoing",
              "contingency"
            ],
            "description": "The fixed spine. Every country pack fills these same eight phases."
          },
          "title": {
            "type": "string"
          },
          "window": {
            "type": "string",
            "description": "When this phase happens relative to move date, e.g. 'T-120 to T-60 days'."
          },
          "intro": {
            "type": "string"
          },
          "appliesTo": {
            "type": "array",
            "description": "Pathway ids this module applies to. Omit or use ['*'] for all.",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "task"
              ],
              "additionalProperties": false,
              "properties": {
                "task": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                },
                "critical": {
                  "type": "boolean",
                  "description": "True if getting this wrong breaks a later step."
                },
                "appliesTo": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$",
                  "description": "Stable identifier, required for any item another item schedules against. Index-based references break the moment content is edited, so scheduling always goes through keys."
                },
                "schedule": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Scheduling metadata consumed by the app plan engine. Content without it still renders in the guide; it simply is not placed on a dated plan.",
                  "properties": {
                    "durationDays": {
                      "type": "number",
                      "minimum": 0,
                      "description": "How long the task itself takes once started — processing, courier, queueing."
                    },
                    "shelfLifeDays": {
                      "type": "number",
                      "minimum": 1,
                      "description": "How long the resulting document stays valid from issue. Requires consumedBy: a shelf life is meaningless without knowing the day it is used."
                    },
                    "consumedBy": {
                      "type": "string",
                      "description": "Key of the task that consumes this document. The engine schedules backwards from it so the document is still valid on the day it is needed."
                    },
                    "dependsOn": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Keys that must finish first."
                    },
                    "absoluteWindow": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "from",
                        "to"
                      ],
                      "description": "A fixed annual calendar window (MM-DD), for obligations tied to the calendar rather than to the mover — work permit renewals, quota filings.",
                      "properties": {
                        "from": {
                          "type": "string",
                          "pattern": "^[0-1][0-9]-[0-3][0-9]$"
                        },
                        "to": {
                          "type": "string",
                          "pattern": "^[0-1][0-9]-[0-3][0-9]$"
                        }
                      }
                    },
                    "recurrence": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "everyDays"
                      ],
                      "properties": {
                        "everyDays": {
                          "type": "number",
                          "minimum": 1
                        },
                        "windowDays": {
                          "type": "number",
                          "minimum": 0
                        },
                        "from": {
                          "enum": [
                            "entry",
                            "move"
                          ]
                        }
                      }
                    },
                    "dayCounter": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "threshold"
                      ],
                      "description": "A day-count threshold that changes the mover's legal position — tax residency, cumulative work days.",
                      "properties": {
                        "threshold": {
                          "type": "number",
                          "minimum": 1
                        },
                        "warnBefore": {
                          "type": "number",
                          "minimum": 0
                        },
                        "label": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "gotchas": {
      "type": "array",
      "description": "Cross-cutting traps that do not belong to one pathway or phase. The highest-value page in the product.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "trap",
          "doThis"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "trap": {
            "type": "string"
          },
          "doThis": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "annoying",
              "expensive",
              "trip-ending"
            ]
          },
          "expires": {
            "type": "string",
            "format": "date",
            "description": "For time-boxed gotchas tied to a rule change. Renderer flags these for review."
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Citation registry. Every factual claim in the pack points here by id. No source, no claim.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "tier",
          "checkedOn"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "primary-law",
              "government",
              "professional",
              "community"
            ],
            "description": "primary-law = the decree/statute itself; government = official agency page; professional = law/accounting firm analysis; community = forums and expat reports. Buyers see this so they know how much weight a claim carries."
          },
          "checkedOn": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          },
          "isOfficialPortal": {
            "type": "boolean",
            "description": "True for a government portal a buyer can transact or confirm on directly. Verification steps should point here wherever possible."
          }
        }
      }
    },
    "contested": {
      "type": "array",
      "description": "Questions where credible sources conflict. Publishing the conflict is more honest and more useful than silently picking a side, and it is the safest way to handle a high-stakes claim without a professional reviewer.",
      "items": {
        "type": "object",
        "required": [
          "question",
          "positions",
          "howToResolve",
          "sourceIds"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "position",
                "heldBy"
              ],
              "additionalProperties": false,
              "properties": {
                "position": {
                  "type": "string"
                },
                "heldBy": {
                  "type": "string"
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "practicalEffect": {
            "type": "string",
            "description": "What the buyer should actually do while the question is unsettled."
          },
          "howToResolve": {
            "type": "string",
            "description": "The concrete step that settles it for the buyer's own facts."
          },
          "sourceIds": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "watchlist": {
      "type": "array",
      "description": "Known and expected changes to the rules. This is the content operation's work queue and the app's alert source. An item graduates to the pack body once it lands.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "status",
          "impact",
          "whatChanges"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "proposed",
              "passed-not-in-force",
              "in-force-unclear",
              "rumoured",
              "enforcement-shift"
            ],
            "description": "'rumoured' means widely reported with no traceable instrument — say so loudly; this is where the scams live."
          },
          "expectedBy": {
            "type": "string",
            "description": "ISO date or a plain-language window."
          },
          "impact": {
            "enum": [
              "none",
              "minor",
              "significant",
              "pathway-changing"
            ]
          },
          "whatChanges": {
            "type": "string",
            "description": "Concretely, what would differ in this pack if it lands."
          },
          "affectsPathways": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checkBy": {
            "type": "string",
            "format": "date",
            "description": "When the publisher must next look at this. Surfaced by build/watch.mjs."
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "description": "Newest first. Generated or checked by build/diff.mjs; shipped in the guide so buyers can see the pack is maintained.",
      "items": {
        "type": "object",
        "required": [
          "version",
          "date",
          "changes"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "summary": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "what"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "rule-change",
                    "correction",
                    "clarification",
                    "new-content",
                    "source-upgrade"
                  ]
                },
                "what": {
                  "type": "string"
                },
                "actionRequired": {
                  "type": "string",
                  "description": "What an existing buyer must now do differently. The reason the update email gets opened."
                },
                "affectsPathways": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
